# Google Gemini (required for POST /api/review)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Max seconds for each Gemini generate call (initial + repair)
# REVIEW_TIMEOUT_SEC=120

# Optional: JDK root for Java sandbox host fallback (folder containing bin/javac and bin/java).
# The folder name often includes the full version, e.g. temurin-17.0.14.jdk — not always "temurin-17.jdk".
# macOS: `/usr/libexec/java_home -v 17` prints the path; or `ls /Library/Java/JavaVirtualMachines/`.
# JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-17.0.14.jdk/Contents/Home

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limits
MAX_CODE_BYTES=100000

# Sandbox (POST /api/run)
SANDBOX_ENABLED=true
SANDBOX_IMAGE=cellebrite-code-sandbox:local
SANDBOX_TIMEOUT_SEC=15
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=1.0
